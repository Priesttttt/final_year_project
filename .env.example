# Copy to .env or export these variables.  All are optional.
# The prototype reads environment variables directly; python-dotenv is not used.

# Data directory for SQLite, blobs and the simulated ledger.
DIMF_DATA_DIR=data

# L2 cluster sizes (PBFT must be 3f+1: 4, 7, 10, 13 ...).
DIMF_CRDT_NODES=3
DIMF_RAFT_NODES=3
DIMF_PBFT_NODES=4

# Simulated network.
DIMF_NET_LATENCY_MS=1.0
DIMF_NET_JITTER_MS=0.5
DIMF_NET_DROP_RATE=0.0

# L3 anchoring.
DIMF_ANCHOR_BATCH=100
DIMF_LEDGER_BACKEND=simulated
DIMF_LEDGER_LATENCY_MS=0.0

# Demo switches.
DIMF_SEED_ON_START=0
DIMF_ALLOW_TAMPER=1

# Optional EVM backend.
# DIMF_LEDGER_BACKEND=evm
# DIMF_EVM_RPC_URL=http://127.0.0.1:8545
# DIMF_EVM_CONTRACT=0x...
# DIMF_EVM_PRIVATE_KEY=0x...
